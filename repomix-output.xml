interface AdminLayoutProps {
  children: React.ReactNode;
  portal?: 'parent' | 'admin';
  title?: string;
  activeNav?: string;
  onNavigate?: (navId: string) => void;
  onTopUpClick?: () => void;
  unreadNotificationsCount?: number;
}

