              variant="outline" 
              size="sm" 
              onClick={() => alert('Exporting monthly meal summary PDF...')}
              className="h-9 text-xs font-bold rounded-xl border-slate-200"
            >
              Export PDF
            </Button>
          </div>
        </div>
